# ── Asistente con IA (sólo lo lee el servidor: server/) ─────────────────────
# Key de Gemini. NUNCA con prefijo VITE_: eso la metería en la web pública.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Opcional. Modelos en orden de preferencia, separados por coma (el segundo es respaldo).
# GEMINI_MODELO="gemini-3.5-flash,gemini-3.5-flash-lite"

# Opcional. Tope de consultas a la IA por día (protege la cuota / la factura).
# ASISTENTE_MAX_DIA=1500

# ── Web (lo lee Vite al compilar) ───────────────────────────────────────────
# En desarrollo la IA se activa sola. En producción sólo si esto es "true"
# Y además el servidor (npm run server) está desplegado con /api/asistente.
# VITE_ASISTENTE_IA="true"
APP_URL="MY_APP_URL"
